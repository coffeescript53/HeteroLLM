+class SplitContext {
+    int previous_;
+public:
+    explicit SplitContext(int split) : previous_(context().split) { context().split = split; }
+    ~SplitContext() { context().split = previous_; }
+};
+} // namespace heterollm_trace
+#define HT_TRACE_JOIN_(a,b) a##b
